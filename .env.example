APP_NAME=Sender
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The core application targets MySQL/MariaDB on cPanel shared hosting.
# SQLite is supported for local throwaway work and automated tests.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sender
DB_USERNAME=sender
DB_PASSWORD=

# Database-backed drivers keep the application free of Redis/Memcached.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Sender platform
# ---------------------------------------------------------------------------
# Set to true only on the installed instance, never on a shared build.
# Controls the optional diagnostics page at /diagnostics.
SENDER_DIAGNOSTICS_ENABLED=false

# ---------------------------------------------------------------------------
# Sender capabilities
# ---------------------------------------------------------------------------
# Comma-separated list of capability subjects that must be establishable for the
# installation to be considered healthy. Anything listed here that the platform
# cannot classify makes `sender:diagnose` exit non-zero.
#
# Leave empty until a feature actually depends on the capability. An empty list
# means "nothing is required", so an unverified capability is reported but does
# not fail the command.
SENDER_REQUIRED_CAPABILITIES=

# Seconds after which the last recorded scheduled run counts as stale. A stale
# but successful run reports DEGRADED; no run, or a failed run, reports UNKNOWN.
# Run evidence lives in the `scheduled_runs` table, so `cache:clear` does not
# erase it.
SENDER_CRON_STALE_AFTER_SECONDS=900

# The `smtp` capability is established only by `php artisan sender:verify-smtp`,
# never inferred from MAIL_* being set. This is how long a recorded verification
# stays current before the capability degrades rather than being trusted
# indefinitely. Re-run the command after changing any mail setting.
SENDER_SMTP_FRESH_AFTER_SECONDS=86400

# ---------------------------------------------------------------------------
# Queue reservation safety
# ---------------------------------------------------------------------------
# A queued job is reserved for QUEUE_RETRY_AFTER seconds before another worker
# may pick it up. If that is shorter than the time a worker may legitimately
# take, a slow but healthy job is processed twice — silently, which for this
# platform means duplicate emails. The invariant below is checked by
# `sender:diagnose` when QUEUE_CONNECTION=database:
#
#   QUEUE_RETRY_AFTER >= SENDER_DEPLOYMENT_LIMIT_MAX_WORKER_RUNTIME_SECONDS
#                       + SENDER_QUEUE_RESERVATION_MARGIN_SECONDS
#
# The shipped defaults give 300 >= 240 + 60. Raise the worker runtime and you
# must raise QUEUE_RETRY_AFTER with it.
# QUEUE_RETRY_AFTER=300
# SENDER_QUEUE_RESERVATION_MARGIN_SECONDS=60

# ---------------------------------------------------------------------------
# Sender deployment limits
# ---------------------------------------------------------------------------
# Ceilings this installation imposes, distinct from the host `requirements` in
# config/sender.php. Uncomment only to raise a ceiling above the default; every
# one of these is also constrained by the host's own PHP settings, so raising a
# limit past what the host allows has no effect.
#
# SENDER_DEPLOYMENT_LIMIT_MAX_UPLOAD_BYTES=10485760
# SENDER_DEPLOYMENT_LIMIT_MAX_TEXT_INPUT_BYTES=2097152
# SENDER_DEPLOYMENT_LIMIT_MAX_URLS_PER_REQUEST=1000
# SENDER_DEPLOYMENT_LIMIT_MAX_WORKER_RUNTIME_SECONDS=240
# SENDER_DEPLOYMENT_LIMIT_MAX_JOB_BATCH_SIZE=250
# SENDER_DEPLOYMENT_LIMIT_MAX_JOB_ATTEMPTS=3
# SENDER_DEPLOYMENT_LIMIT_MAX_STORAGE_BYTES=536870912
# SENDER_DEPLOYMENT_LIMIT_MAX_API_REQUESTS_PER_HOUR=1000
# SENDER_DEPLOYMENT_LIMIT_MAX_CAMPAIGN_RECIPIENTS=100000